{
  "name": "@youtube-to-opus/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@youtube-to-opus/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.4"
  }
}
