{
  "name": "youtube-to-opus",
  "type": "module",
  "version": "1.0.0",
  "description": "YouTube link to OPUS converter with web UI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:client": "vite build",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide": "^1.16.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.4"
  }
}
