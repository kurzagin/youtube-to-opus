{
  "name": "youtube-to-opus-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"@youtube-to-opus/web\" dev",
    "mobile": "bun run --cwd apps/mobile expo start --go",
    "mobile:tunnel": "bun run --cwd apps/mobile expo start --go --tunnel",
    "dev:mobile": "bun run --cwd apps/mobile expo start --go",
    "dev:web": "bun --filter \"@youtube-to-opus/web\" dev",
    "build:web": "bun --filter \"@youtube-to-opus/web\" build",
    "mobile:prebuild": "bun run --cwd apps/mobile prebuild",
    "build:apk": "bun run --cwd apps/mobile build:apk",
    "build:apk:debug": "bun run --cwd apps/mobile build:debug",
    "typecheck": "bun --filter \"*\" typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
